{% extends "base.html" %}{% block content %}<header><div><small>ПЛАНИРОВАНИЕ</small><h1>Календарь публикаций</h1><p>Максимум одна рассылка в день · выходные закрыты</p></div><div>🟣 Лучшие дни · ⚪ Выходные</div></header><div class="toolbar"><button id="prev">←</button><button id="today">Сегодня</button><button id="next">→</button><h2 id="month"></h2><button id="new" class="primary">+ Забронировать</button></div><section class="calendar"><div class="week">{% for x in ['Пн','Вт','Ср','Чт','Пт','Сб','Вс'] %}<b>{{x}}</b>{% endfor %}</div><div id="grid"></div></section><section class="lower"><div class="card"><h3>Предстоящие</h3><div id="upcoming"></div></div><div class="card"><h3>Правила</h3><p>Вт–Чт — лучшие дни<br>Пн и Пт — можно<br>Сб и Вс — запрещены<br>1 дата = 1 публикация</p></div></section><div id="modal" class="modal hidden"><div class="card"><button id="x" class="x">×</button><h2 id="mt">Публикация</h2><label>Дата<input id="date" type="date"></label><label>Название<input id="title" maxlength="255"></label>{% if user.role=="admin" %}<label>Команда<select id="team">{% for t in teams %}<option value="{{t.id}}">{{t.name}}</option>{% endfor %}</select></label>{% endif %}<label><input id="important" type="checkbox"> ⭐ Важная</label><div class="actions"><button id="del" class="danger hidden">Удалить</button><span></span><button id="cancel">Отмена</button><button id="save" class="primary">Сохранить</button></div></div></div><script>
let cur=new Date(new Date().getFullYear(),new Date().getMonth(),1), bs=[],edit=null; const ru=['Январь','Февраль','Март','Апрель','Май','Июнь','Июль','Август','Сентябрь','Октябрь','Ноябрь','Декабрь'],pad=n=>String(n).padStart(2,'0'),iso=d=>`${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`; const grid=document.querySelector('#grid');
async function load(){let s=new Date(cur.getFullYear(),cur.getMonth()-1,1),e=new Date(cur.getFullYear(),cur.getMonth()+2,0);bs=await fetch(`/api/bookings?start=${iso(s)}&end=${iso(e)}`).then(r=>r.json());render()}
function render(){document.querySelector('#month').textContent=ru[cur.getMonth()]+' '+cur.getFullYear();grid.innerHTML='';let f=new Date(cur.getFullYear(),cur.getMonth(),1),off=(f.getDay()+6)%7,n=new Date(cur.getFullYear(),cur.getMonth()+1,0).getDate();for(let i=0;i<off;i++)grid.appendChild(document.createElement('i'));for(let d=1;d<=n;d++){let x=new Date(cur.getFullYear(),cur.getMonth(),d),wd=x.getDay(),ds=iso(x),closed=wd==0||wd==6,b=bs.find(v=>v.date==ds),el=document.createElement('div');el.className='day '+(closed?'closed ':'')+([2,3,4].includes(wd)?'best':'');el.innerHTML=`<b>${d}</b>${[2,3,4].includes(wd)&&!closed?'<small>Лучший день</small>':''}${b?`<div class="booking" style="border-color:${b.color}"><b>${b.important?'⭐ ':''}${esc(b.title)}</b><small>${esc(b.team)}</small></div>`:''}`;if(!closed)el.onclick=()=>open(ds,b);grid.appendChild(el)}document.querySelector('#upcoming').innerHTML=bs.filter(x=>x.date>=iso(new Date())).sort((a,b)=>a.date.localeCompare(b.date)).slice(0,8).map(x=>`<p><b>${x.date}</b> — ${x.important?'⭐ ':''}${esc(x.title)} <small>(${esc(x.team)})</small></p>`).join('')||'<p>Пока пусто.</p>'}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]) )}
function open(ds,b){edit=b;modal.classList.remove('hidden');document.querySelector('#mt').textContent=b?'Изменить':'Забронировать';document.querySelector('#date').value=ds;document.querySelector('#title').value=b?b.title:'';document.querySelector('#important').checked=b?b.important:false;document.querySelector('#del').classList.toggle('hidden',!b);if(b&&document.querySelector('#team'))document.querySelector('#team').value=b.teamId}
function close(){modal.classList.add('hidden');edit=null}
document.querySelector('#prev').onclick=()=>{cur.setMonth(cur.getMonth()-1);load()};document.querySelector('#next').onclick=()=>{cur.setMonth(cur.getMonth()+1);load()};document.querySelector('#today').onclick=()=>{cur=new Date(new Date().getFullYear(),new Date().getMonth(),1);load()};document.querySelector('#new').onclick=()=>open(iso(new Date()),null);document.querySelector('#x').onclick=close;document.querySelector('#cancel').onclick=close;
document.querySelector('#save').onclick=async()=>{let body={date:date.value,title:title.value,important:important.checked};if(document.querySelector('#team'))body.teamId=+team.value;let r=await fetch(edit?`/api/bookings/${edit.id}`:'/api/bookings',{method:edit?'PUT':'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}),j=await r.json();if(!r.ok)return alert(j.error);close();load()};document.querySelector('#del').onclick=async()=>{if(confirm('Удалить?')){let r=await fetch(`/api/bookings/${edit.id}`,{method:'DELETE'});if(r.ok){close();load()}}};load();
</script>{% endblock %}